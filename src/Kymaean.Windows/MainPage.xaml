<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Kymaean.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:application="using:Kymaean.Application"
    xmlns:presentation="using:Kymaean.Windows.Presentation"
    Background="{ThemeResource KymaeanFieldBrush}">

    <Page.Resources>
        <presentation:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <NavigationView
        x:Name="ShellNavigation"
        AlwaysShowHeader="False"
        Background="{ThemeResource KymaeanFieldBrush}"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="176"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedDisabled" Color="Transparent" />
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="HomeNavigationItem"
                Content="Home"
                Foreground="{ThemeResource KymaeanPrimaryBrush}"
                Tag="Home" />
            <NavigationViewItem
                x:Name="ProductionsNavigationItem"
                Content="Productions"
                Foreground="{ThemeResource KymaeanPrimaryBrush}"
                Tag="Productions" />
            <NavigationViewItem
                Content="Settings"
                Foreground="{ThemeResource KymaeanPrimaryBrush}"
                Tag="Settings" />
        </NavigationView.MenuItems>

        <Grid Background="{ThemeResource KymaeanSoftSurfaceBrush}">
            <Grid IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.09*" />
                    <ColumnDefinition Width="0.30*" />
                    <ColumnDefinition Width="0.61*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="1"
                    Height="16"
                    VerticalAlignment="Top"
                    Background="{ThemeResource KymaeanFieldBrush}" />
                <Grid
                    Grid.Column="2"
                    Width="20"
                    HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.57*" />
                        <RowDefinition Height="0.23*" />
                        <RowDefinition Height="0.20*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource KymaeanFieldBrush}" />
                </Grid>
            </Grid>
            <Grid Padding="28,24,36,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                        Text="KYMÆAN" />
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                        Text="{Binding PageTitle}" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                        Text="{Binding PageSummary}" />
                    <Border
                        Height="1"
                        Margin="0,12,0,0"
                        Background="{ThemeResource KymaeanBoundaryBrush}" />
                    <Border
                        Margin="0,10,0,0"
                        Padding="12"
                        BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,26,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="Home" />
                                <TextBlock
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="Open a Production from your library when one is available."
                                    TextWrapping="Wrap" />
                                <Border
                                    Margin="0,10,0,0"
                                    Padding="20"
                                    BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                    BorderThickness="0,1,0,1"
                                    Visibility="{Binding HasCurrentProduction, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="CURRENT PRODUCTION" />
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="{Binding CurrentProductionName}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsProductions, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="Productions" />
                                <TextBlock
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="Choose a Production to open, or use Recover when needed."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ListView
                                x:Name="ProductionList"
                                Grid.Row="1"
                                Margin="0,18,0,0"
                                ItemsSource="{Binding Productions}"
                                SelectionChanged="OnProductionSelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter
                                            Property="AutomationProperties.Name"
                                            Value="{Binding ProductionName}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="application:ProductionSummary">
                                        <Border
                                            MinWidth="360"
                                            Padding="12"
                                            BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                            BorderThickness="0,0,0,1">
                                            <TextBlock
                                                FontSize="18"
                                                Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                                Text="{x:Bind ProductionName}" />
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                Grid.Row="2"
                                Margin="0,16,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="Open selected Production"
                                    Click="OnOpenProductionClicked"
                                    Content="Open"
                                    IsEnabled="{Binding CanAccessSelection}" />
                                <Button
                                    AutomationProperties.Name="Recover selected Production"
                                    Click="OnRecoverProductionClicked"
                                    Content="Recover"
                                    IsEnabled="{Binding CanAccessSelection}" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsCurrentProduction, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="10">
                                <Button
                                    AutomationProperties.Name="Back"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Click="OnBackToProductionsClicked"
                                    FocusVisualMargin="2"
                                    HorizontalAlignment="Left"
                                    Padding="6"
                                    ToolTipService.ToolTip="Back"
                                    UseSystemFocusVisuals="True">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="20"
                                        Glyph="&#xE72B;" />
                                </Button>
                                <TextBlock
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="This Production is open."
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Margin="0,12,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Product space" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="{Binding ActiveProductSpace}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="Settings" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
