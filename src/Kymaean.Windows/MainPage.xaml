<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Kymaean.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:application="using:Kymaean.Application"
    xmlns:presentation="using:Kymaean.Windows.Presentation"
    Background="{ThemeResource KymaeanFieldBrush}">

    <Page.Resources>
        <presentation:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="WorldTruthTextTemplate">
            <Border
                Padding="0,8"
                BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    AutomationProperties.Name="{Binding}"
                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                    Text="{Binding}"
                    TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="CharacterRowTemplate"
            x:DataType="presentation:CharacterPresentationRow">
            <Border
                AutomationProperties.Name="{x:Bind AccessibleName}"
                Padding="10,8"
                BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                        Text="{x:Bind CharacterName}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                        Text="{x:Bind CharacterCodeLabel}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasCharacterCode, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="SceneOverviewRowTemplate"
            x:DataType="presentation:ScenePresentationRow">
            <Border
                Padding="0,8"
                BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                        Text="{x:Bind CodeLabel}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                        Text="{x:Bind RosterSummary}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <NavigationView
        x:Name="ShellNavigation"
        IsEnabled="{Binding IsSceneNavigationEnabled}"
        AlwaysShowHeader="False"
        Background="{ThemeResource KymaeanFieldBrush}"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="176"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedDisabled" Color="Transparent" />
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="HomeNavigationItem"
                Content="Home"
                Foreground="{ThemeResource KymaeanPrimaryBrush}"
                Tag="Home" />
            <NavigationViewItem
                x:Name="ProductionsNavigationItem"
                Content="Productions"
                Foreground="{ThemeResource KymaeanPrimaryBrush}"
                Tag="Productions" />
            <NavigationViewItem
                Content="Settings"
                Foreground="{ThemeResource KymaeanPrimaryBrush}"
                Tag="Settings" />
        </NavigationView.MenuItems>

        <Grid Background="{ThemeResource KymaeanSoftSurfaceBrush}">
            <Grid IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.09*" />
                    <ColumnDefinition Width="0.30*" />
                    <ColumnDefinition Width="0.61*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="1"
                    Height="16"
                    VerticalAlignment="Top"
                    Background="{ThemeResource KymaeanFieldBrush}" />
                <Grid
                    Grid.Column="2"
                    Width="20"
                    HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.57*" />
                        <RowDefinition Height="0.23*" />
                        <RowDefinition Height="0.20*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource KymaeanFieldBrush}" />
                </Grid>
            </Grid>
            <Grid Padding="28,24,36,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                        Text="KYMÆAN" />
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                        Text="{Binding PageTitle}" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                        Text="{Binding PageSummary}" />
                    <Border
                        Height="1"
                        Margin="0,12,0,0"
                        Background="{ThemeResource KymaeanBoundaryBrush}" />
                    <Border
                        Margin="0,10,0,0"
                        Padding="12"
                        BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,26,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="Home" />
                                <TextBlock
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="Open a Production from your library when one is available."
                                    TextWrapping="Wrap" />
                                <Border
                                    Margin="0,10,0,0"
                                    Padding="20"
                                    BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                    BorderThickness="0,1,0,1"
                                    Visibility="{Binding HasCurrentProduction, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="CURRENT PRODUCTION" />
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="{Binding CurrentProductionName}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsProductions, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="Productions" />
                                <TextBlock
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="Choose a Production to open, or use Recover when needed."
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="NewProductionButton"
                                    AutomationProperties.Name="New Production"
                                    HorizontalAlignment="Left"
                                    Click="OnNewProductionClicked"
                                    Content="New Production"
                                    Visibility="{Binding IsProductionCreationFormClosed, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Border
                                Grid.Row="1"
                                Margin="0,16,0,0"
                                Padding="0,12"
                                BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                BorderThickness="0,1,0,1"
                                Visibility="{Binding IsProductionCreationFormOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level3"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="New Production" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Create a Production here, then open it when you are ready."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Production name" />
                                    <TextBox
                                        x:Name="ProductionNameTextBox"
                                        AutomationProperties.Name="Production name"
                                        MaxWidth="560"
                                        HorizontalAlignment="Stretch"
                                        Text="{Binding ProductionNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        AutomationProperties.Name="{Binding ProductionCreationValidationMessage}"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="{Binding ProductionCreationValidationMessage}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasProductionCreationValidationMessage, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Creating Production…"
                                        Visibility="{Binding IsProductionCreationPending, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            AutomationProperties.Name="Create Production"
                                            Click="OnCreateProductionClicked"
                                            Content="Create Production"
                                            IsEnabled="{Binding IsProductionCreationEnabled}" />
                                        <Button
                                            AutomationProperties.Name="Cancel Production creation"
                                            Click="OnCancelProductionCreationClicked"
                                            Content="Cancel"
                                            IsEnabled="{Binding IsProductionCreationEnabled}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel
                                Grid.Row="2"
                                Margin="0,18,0,0"
                                Spacing="8">
                                <TextBlock
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="No Productions yet."
                                    Visibility="{Binding HasNoProductions, Converter={StaticResource BoolToVisibility}}" />
                                <ListView
                                    x:Name="ProductionList"
                                    ContainerContentChanging="OnProductionContainerContentChanging"
                                    ItemsSource="{Binding ProductionRows}"
                                    SelectionChanged="OnProductionSelectionChanged"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:ProductionPresentationRow">
                                            <Border
                                                Padding="12"
                                                BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                                BorderThickness="0,0,0,1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        FontSize="18"
                                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                                        Text="{x:Bind ProductionName}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                                        Text="{x:Bind ProductionCodeLabel}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding HasProductionCode, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="3"
                                Margin="0,16,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="Open selected Production"
                                    Click="OnOpenProductionClicked"
                                    Content="Open"
                                    IsEnabled="{Binding CanAccessSelection}" />
                                <Button
                                    AutomationProperties.Name="Recover selected Production"
                                    Click="OnRecoverProductionClicked"
                                    Content="Recover"
                                    IsEnabled="{Binding CanAccessSelection}" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsCurrentProductionOverview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel
                                MaxWidth="900"
                                HorizontalAlignment="Stretch"
                                Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        AutomationProperties.Name="Back"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Click="OnBackToProductionsClicked"
                                        FocusVisualMargin="2"
                                        HorizontalAlignment="Left"
                                        Padding="6"
                                        ToolTipService.ToolTip="Back"
                                        UseSystemFocusVisuals="True">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="20"
                                            Glyph="&#xE72B;" />
                                    </Button>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="Product space" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="{Binding ActiveProductSpace}" />
                                    </StackPanel>
                                </Grid>

                                <Border
                                    Padding="0,18,0,0"
                                    BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level2"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="World truths" />
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level3"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="Confirmation unavailable"
                                            Visibility="{Binding HasWorldTruthOverviewUncertainty, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="{Binding WorldTruthOverviewDescription}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="Last confirmed world truths"
                                            Visibility="{Binding HasWorldTruthOverviewUncertainty, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl
                                            ItemsSource="{Binding OverviewWorldTruths}"
                                            ItemTemplate="{StaticResource WorldTruthTextTemplate}"
                                            Visibility="{Binding HasOverviewWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="{Binding WorldTruthOverviewEmptyMessage}"
                                            Visibility="{Binding HasNoOverviewWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="More world truths are available."
                                            Visibility="{Binding HasMoreOverviewWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            x:Name="WorldTruthsButton"
                                            AutomationProperties.Name="World truths"
                                            HorizontalAlignment="Left"
                                            Click="OnOpenWorldTruthsClicked"
                                            Content="World truths" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="0,18,0,0"
                                    BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level2"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="Characters" />
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level3"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="Confirmation unavailable"
                                            Visibility="{Binding HasCharacterOverviewUncertainty, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="{Binding CharacterOverviewDescription}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="Last confirmed Characters"
                                            Visibility="{Binding HasCharacterOverviewUncertainty, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl
                                            ItemsSource="{Binding OverviewCharacterRows}"
                                            ItemTemplate="{StaticResource CharacterRowTemplate}"
                                            Visibility="{Binding HasOverviewCharacters, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="{Binding CharacterOverviewEmptyMessage}"
                                            Visibility="{Binding HasNoOverviewCharacters, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="More Characters are available."
                                            Visibility="{Binding HasMoreOverviewCharacters, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            x:Name="CharactersButton"
                                            AutomationProperties.Name="Characters"
                                            HorizontalAlignment="Left"
                                            Click="OnOpenCharactersClicked"
                                            Content="Characters" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="0,18,0,0"
                                    BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level2"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="{Binding SceneListHeading}" />
                                        <TextBlock
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="{Binding SceneListDescription}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            AutomationProperties.Name="{Binding SceneNotice}"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="{Binding SceneNotice}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasSceneNotice, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl
                                            ItemsSource="{Binding OverviewSceneRows}"
                                            ItemTemplate="{StaticResource SceneOverviewRowTemplate}"
                                            Visibility="{Binding HasScenes, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="{Binding SceneEmptyMessage}"
                                            Visibility="{Binding HasNoScenes, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                            Text="More Scenes are available."
                                            Visibility="{Binding HasMoreOverviewScenes, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            x:Name="ScenesButton"
                                            AutomationProperties.Name="Scenes"
                                            HorizontalAlignment="Left"
                                            Click="OnOpenScenesClicked"
                                            Content="Scenes" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="12" Visibility="{Binding IsSceneSurface, Converter={StaticResource BoolToVisibility}}">
                            <Button x:Name="SceneBackButton" AutomationProperties.Name="Back" Click="OnSceneBackClicked"
                                    Background="Transparent" BorderBrush="Transparent" FocusVisualMargin="2" HorizontalAlignment="Left" Padding="6"
                                    ToolTipService.ToolTip="Back" UseSystemFocusVisuals="True">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Glyph="&#xE72B;" />
                            </Button>
                            <StackPanel Spacing="12" Visibility="{Binding IsScenes, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl x:Name="ScenesHeading" IsTabStop="True" UseSystemFocusVisuals="True"
                                                HorizontalAlignment="Left" AutomationProperties.HeadingLevel="Level2"
                                                AutomationProperties.Name="{Binding SceneListHeading}">
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                               Text="{Binding SceneListHeading}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                                </ContentControl>
                                <TextBlock Text="{Binding SceneListDescription}" TextWrapping="Wrap" />
                                <TextBlock Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                           Text="{Binding SceneListInstruction}" TextWrapping="Wrap" />
                                <TextBlock x:Name="SceneCollisionNotice" AutomationProperties.HeadingLevel="Level3"
                                           Text="Kymaean cannot distinguish some Scenes safely. Inspection and New Scene are unavailable until the Production is reopened without this conflict."
                                           TextWrapping="Wrap" Visibility="{Binding HasSceneCollision, Converter={StaticResource BoolToVisibility}}" />
                                <Button x:Name="NewSceneButton" Content="New Scene" Click="OnNewSceneClicked"
                                        IsEnabled="{Binding CanEstablishScene}" HorizontalAlignment="Left"
                                        AutomationProperties.HelpText="{Binding SceneNewSceneHelp}" />
                                <ContentControl x:Name="SceneNotice" IsTabStop="True" UseSystemFocusVisuals="True"
                                                HorizontalAlignment="Left" AutomationProperties.HeadingLevel="Level3"
                                                AutomationProperties.Name="{Binding SceneNotice}"
                                                Visibility="{Binding HasSceneNotice, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SceneNotice}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                                </ContentControl>
                                <TextBlock Text="{Binding SceneEmptyMessage}" Visibility="{Binding HasNoScenes, Converter={StaticResource BoolToVisibility}}" />
                                <Border BorderBrush="{ThemeResource KymaeanBoundaryBrush}" BorderThickness="1"
                                        Visibility="{Binding HasScenes, Converter={StaticResource BoolToVisibility}}">
                                    <ListView IsTabStop="False" x:Name="SceneList" ItemsSource="{Binding SceneRows}"
                                              SelectionMode="None" IsItemClickEnabled="False" IsSwipeEnabled="False"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ContainerContentChanging="OnSceneContainerContentChanging">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="IsFocusEngagementEnabled" Value="True" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="presentation:ScenePresentationRow">
                                                <Border Padding="14,12" BorderBrush="{ThemeResource KymaeanBoundaryBrush}" BorderThickness="0,0,0,1">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind CodeLabel}" TextWrapping="Wrap"
                                                                       AutomationProperties.AccessibilityView="Raw" />
                                                            <TextBlock FontSize="14" Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                                                       Text="{x:Bind RosterSummary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Click="OnInspectSceneClicked" IsEnabled="{x:Bind CanInspect}"
                                                                UseSystemFocusVisuals="True" AutomationProperties.Name="{x:Bind InspectName}"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="Inspect initial roster" TextWrapping="Wrap" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                                <StackPanel Spacing="8" Visibility="{Binding HasSceneUncertainty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Submitted initial roster" AutomationProperties.HeadingLevel="Level3" FontWeight="SemiBold" />
                                    <ItemsControl IsTabStop="False" ItemsSource="{Binding SubmittedSceneRoster}" ItemTemplate="{StaticResource CharacterRowTemplate}" />
                                    <TextBlock Text="No Characters in this submitted initial roster." TextWrapping="Wrap"
                                               Visibility="{Binding HasEmptySubmittedSceneRoster, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Open the Production again to inspect its recorded Scenes. A matching roster cannot confirm which submission created a Scene." TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="12" Visibility="{Binding IsSceneDetail, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl IsTabStop="False" AutomationProperties.HeadingLevel="Level2"
                                                AutomationProperties.Name="{Binding InspectedScene.DetailHeadingName}" HorizontalAlignment="Left">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Initial roster" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource KymaeanPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Text="{Binding InspectedScene.CodeLabel}" TextWrapping="Wrap"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                    </StackPanel>
                                </ContentControl>
                                <ItemsControl IsTabStop="False" ItemsSource="{Binding InspectedScene.Roster}" ItemTemplate="{StaticResource CharacterRowTemplate}" />
                                <TextBlock Text="No Characters in this initial roster." TextWrapping="Wrap"
                                           Visibility="{Binding InspectedScene.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Spacing="12" Visibility="{Binding IsSceneDraft, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl x:Name="SceneDraftHeading" IsTabStop="True" UseSystemFocusVisuals="True" HorizontalAlignment="Left"
                                                AutomationProperties.HeadingLevel="Level2"
                                                AutomationProperties.Name="New Scene. Choose Characters from this Production. You can leave the initial roster empty.">
                                    <TextBlock Text="New Scene" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                               AutomationProperties.AccessibilityView="Raw" />
                                </ContentControl>
                                <TextBlock Text="Initial roster" FontWeight="SemiBold" />
                                <TextBlock Text="Choose Characters from this Production. You can leave the initial roster empty." TextWrapping="Wrap" />
                                <TextBlock Text="No Characters in this Production yet. You can establish a Scene with an empty initial roster." TextWrapping="Wrap"
                                           Visibility="{Binding HasNoSceneCast, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl IsTabStop="False" x:Name="ScenePicker" ItemsSource="{Binding SceneCast}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:CharacterPresentationRow">
                                            <CheckBox Checked="OnSceneCharacterChanged" Unchecked="OnSceneCharacterChanged"
                                                      AutomationProperties.Name="{x:Bind AccessibleName}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{x:Bind AccessibleName}" TextWrapping="Wrap" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Review initial roster" AutomationProperties.HeadingLevel="Level3" FontWeight="SemiBold" />
                                <ItemsControl IsTabStop="False" ItemsSource="{Binding SceneDraftRoster}" ItemTemplate="{StaticResource CharacterRowTemplate}" />
                                <TextBlock Text="No Characters in this initial roster." TextWrapping="Wrap"
                                           Visibility="{Binding HasEmptySceneDraft, Converter={StaticResource BoolToVisibility}}" />
                                <Button x:Name="EstablishSceneButton" Content="Establish Scene" Click="OnEstablishSceneClicked"
                                        IsEnabled="{Binding CanEstablishScene}" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Cancel" Click="OnCancelSceneClicked" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Visibility="{Binding IsWorldTruthSurface, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="12">
                                <Button
                                    x:Name="WorldTruthBackButton"
                                    AutomationProperties.Name="Back"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Click="OnBackFromWorldTruthsClicked"
                                    FocusVisualMargin="2"
                                    HorizontalAlignment="Left"
                                    Padding="6"
                                    ToolTipService.ToolTip="Back"
                                    UseSystemFocusVisuals="True">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="20"
                                        Glyph="&#xE72B;" />
                                </Button>

                                <StackPanel
                                    Spacing="10"
                                    Visibility="{Binding IsWorldTruthInspection, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Current world truths" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="What is currently true in this Production's world."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Creator view — this does not describe what any Character knows or believes."
                                        TextWrapping="Wrap" />
                                    <Border
                                        Padding="10,8"
                                        BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                        BorderThickness="0,1,0,1"
                                        Visibility="{Binding HasWorldTruthStatusMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock
                                            AutomationProperties.Name="{Binding WorldTruthStatusMessage}"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="{Binding WorldTruthStatusMessage}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <ItemsControl
                                        ItemTemplate="{StaticResource WorldTruthTextTemplate}"
                                        ItemsSource="{Binding CurrentWorldTruths}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="There are no current world truths."
                                        Visibility="{Binding HasNoCurrentWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        x:Name="EditWorldTruthsButton"
                                        AutomationProperties.Name="Edit replacement"
                                        HorizontalAlignment="Left"
                                        Click="OnEditWorldTruthsClicked"
                                        Content="Edit replacement" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="10"
                                    Visibility="{Binding IsWorldTruthEdit, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Proposed replacement" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Changes here are local until you review and replace the entire current world truth set."
                                        TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding WorldTruthDraftItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        AutomationProperties.Name="World truth text"
                                                        MinWidth="300"
                                                        AcceptsReturn="True"
                                                        Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TextWrapping="Wrap" />
                                                    <Button
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="Remove world truth"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Top"
                                                        Click="OnRemoveWorldTruthClicked"
                                                        Content="Remove" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        x:Name="AddWorldTruthButton"
                                        AutomationProperties.Name="Add world truth"
                                        HorizontalAlignment="Left"
                                        Click="OnAddWorldTruthClicked"
                                        Content="Add world truth" />
                                    <TextBlock
                                        AutomationProperties.Name="{Binding WorldTruthDraftValidationMessage}"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="{Binding WorldTruthDraftValidationMessage}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasWorldTruthDraftValidationMessage, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            AutomationProperties.Name="Review replacement"
                                            Click="OnReviewWorldTruthsClicked"
                                            Content="Review replacement" />
                                        <Button
                                            AutomationProperties.Name="Cancel replacement"
                                            Click="OnCancelWorldTruthProposalClicked"
                                            Content="Cancel" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Spacing="12"
                                    Visibility="{Binding IsWorldTruthReview, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Review replacement" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="This will replace the entire current world truth set."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Current world truths" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource WorldTruthTextTemplate}"
                                        ItemsSource="{Binding CurrentWorldTruths}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="The current set is empty."
                                        Visibility="{Binding HasNoCurrentWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Proposed replacement" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource WorldTruthTextTemplate}"
                                        ItemsSource="{Binding ReviewWorldTruths}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="The proposed replacement is empty."
                                        Visibility="{Binding HasNoReviewWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            AutomationProperties.Name="Back to edit replacement"
                                            Click="OnBackToWorldTruthEditClicked"
                                            Content="Back to edit" />
                                        <Button
                                            x:Name="ReplaceWorldTruthsButton"
                                            AutomationProperties.Name="Replace current world truths"
                                            Click="OnReplaceWorldTruthsClicked"
                                            Content="Replace current world truths" />
                                        <Button
                                            AutomationProperties.Name="Cancel replacement"
                                            Click="OnCancelWorldTruthProposalClicked"
                                            Content="Cancel" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Spacing="8"
                                    Visibility="{Binding IsWorldTruthSubmitting, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Updating current world truths" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Kymaean is confirming the replacement."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="10"
                                    Visibility="{Binding IsWorldTruthTypedFailure, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Replacement not applied" />
                                    <TextBlock
                                        AutomationProperties.Name="{Binding WorldTruthFailureMessage}"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="{Binding WorldTruthFailureMessage}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Current world truths" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource WorldTruthTextTemplate}"
                                        ItemsSource="{Binding CurrentWorldTruths}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="The current set is empty."
                                        Visibility="{Binding HasNoCurrentWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Not applied" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource WorldTruthTextTemplate}"
                                        ItemsSource="{Binding NotAppliedWorldTruths}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="The not-applied replacement is empty."
                                        Visibility="{Binding HasNoNotAppliedWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="10"
                                    Visibility="{Binding IsWorldTruthConfirmationUnavailable, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Confirmation unavailable" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Kymaean couldn't confirm whether the replacement became current."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Last confirmed world truths" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource WorldTruthTextTemplate}"
                                        ItemsSource="{Binding LastConfirmedWorldTruths}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="The last confirmed set was empty."
                                        Visibility="{Binding HasNoLastConfirmedWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Submitted replacement" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource WorldTruthTextTemplate}"
                                        ItemsSource="{Binding SubmittedWorldTruths}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="The submitted replacement was empty."
                                        Visibility="{Binding HasNoSubmittedWorldTruths, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="13"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Open the Production again to establish authoritative current world truths before making another replacement."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsCharacterSurface, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="12">
                                <Button
                                    x:Name="CharacterBackButton"
                                    AutomationProperties.Name="Back"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Click="OnBackFromCharactersClicked"
                                    FocusVisualMargin="2"
                                    HorizontalAlignment="Left"
                                    Padding="6"
                                    ToolTipService.ToolTip="Back"
                                    UseSystemFocusVisuals="True">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="20"
                                        Glyph="&#xE72B;" />
                                </Button>

                                <StackPanel
                                    Spacing="10"
                                    Visibility="{Binding IsCharacterInspection, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Characters" />
                                    <Border
                                        Padding="10,8"
                                        BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                                        BorderThickness="0,1,0,1"
                                        Visibility="{Binding HasCharacterStatusMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock
                                            AutomationProperties.Name="{Binding CharacterStatusMessage}"
                                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                            Text="{Binding CharacterStatusMessage}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <ListView
                                        x:Name="CharacterList"
                                        ContainerContentChanging="OnCharacterContainerContentChanging"
                                        ItemTemplate="{StaticResource CharacterRowTemplate}"
                                        ItemsSource="{Binding CharacterRows}"
                                        SelectionMode="None" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="No Characters yet."
                                        Visibility="{Binding HasNoCharacters, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        x:Name="NewCharacterButton"
                                        AutomationProperties.Name="New Character"
                                        HorizontalAlignment="Left"
                                        Click="OnNewCharacterClicked"
                                        Content="New Character" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="10"
                                    Visibility="{Binding IsCharacterCreation, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="New Character" />
                                    <TextBox
                                        x:Name="CharacterNameTextBox"
                                        AutomationProperties.Name="Character name"
                                        Header="Character name"
                                        HorizontalAlignment="Stretch"
                                        Text="{Binding CharacterNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        AutomationProperties.Name="{Binding CharacterCreationValidationMessage}"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="{Binding CharacterCreationValidationMessage}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasCharacterCreationValidationMessage, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="CreateCharacterButton"
                                            AutomationProperties.Name="Create Character"
                                            Click="OnCreateCharacterClicked"
                                            Content="Create Character"
                                            IsEnabled="{Binding IsCharacterCreationEnabled}" />
                                        <Button
                                            AutomationProperties.Name="Cancel Character creation"
                                            Click="OnCancelCharacterCreationClicked"
                                            Content="Cancel" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Spacing="8"
                                    Visibility="{Binding IsCharacterSubmitting, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Confirming Character" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Kymaean is confirming the new Character."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="10"
                                    Visibility="{Binding IsCharacterTypedFailure, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Character not created" />
                                    <TextBlock
                                        AutomationProperties.Name="{Binding CharacterFailureMessage}"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="{Binding CharacterFailureMessage}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Current Characters" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource CharacterRowTemplate}"
                                        ItemsSource="{Binding CharacterRows}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="No Characters yet."
                                        Visibility="{Binding HasNoCharacters, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        x:Name="CharacterTypedFailureBackButton"
                                        AutomationProperties.Name="Back to Characters"
                                        HorizontalAlignment="Left"
                                        Click="OnBackFromCharacterFailureClicked"
                                        Content="Back to Characters" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="10"
                                    Visibility="{Binding IsCharacterConfirmationUnavailable, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Confirmation unavailable" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="Kymaean couldn't confirm whether this Character was created."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Last confirmed Characters" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource CharacterRowTemplate}"
                                        ItemsSource="{Binding LastConfirmedCharacterRows}" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="There were no last confirmed Characters."
                                        Visibility="{Binding HasNoLastConfirmedCharacters, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Submitted Character" />
                                    <TextBlock
                                        AutomationProperties.Name="{Binding SubmittedCharacterName}"
                                        Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                        Text="{Binding SubmittedCharacterName}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="13"
                                        Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                        Text="Open the Production again to establish authoritative Characters before creating another Character."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="Settings" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
