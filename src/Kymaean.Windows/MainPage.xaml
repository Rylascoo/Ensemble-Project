<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Kymaean.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:application="using:Kymaean.Application"
    xmlns:presentation="using:Kymaean.Windows.Presentation"
    Background="{ThemeResource KymaeanFieldBrush}">

    <Page.Resources>
        <presentation:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <presentation:HistoryCountToTextConverter x:Key="HistoryCountToText" />
    </Page.Resources>

    <NavigationView
        x:Name="ShellNavigation"
        AlwaysShowHeader="False"
        Background="{ThemeResource KymaeanFieldBrush}"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="176"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedDisabled" Color="Transparent" />
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Foreground="{ThemeResource KymaeanPrimaryBrush}" Tag="Home" />
            <NavigationViewItem Content="Productions" Foreground="{ThemeResource KymaeanPrimaryBrush}" Tag="Productions" />
            <NavigationViewItem Content="Settings" Foreground="{ThemeResource KymaeanPrimaryBrush}" Tag="Settings" />
        </NavigationView.MenuItems>

        <Grid Background="{ThemeResource KymaeanSoftSurfaceBrush}">
            <Grid IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.09*" />
                    <ColumnDefinition Width="0.30*" />
                    <ColumnDefinition Width="0.61*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="1"
                    Height="16"
                    VerticalAlignment="Top"
                    Background="{ThemeResource KymaeanFieldBrush}" />
                <Grid
                    Grid.Column="2"
                    Width="20"
                    HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.57*" />
                        <RowDefinition Height="0.23*" />
                        <RowDefinition Height="0.20*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource KymaeanFieldBrush}" />
                </Grid>
            </Grid>

            <Grid Padding="28,24,36,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="5">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                    Text="CURRENT PRODUCTION" />
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                    Text="{Binding ProductionName}" />
                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource KymaeanSecondaryBrush}">
                    <Run Text="Current situation · " />
                    <Run Text="{Binding CurrentSituation}" />
                </TextBlock>
                <Border
                    Height="1"
                    Margin="0,12,0,0"
                    Background="{ThemeResource KymaeanBoundaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,26,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ShapingButton"
                            AutomationProperties.Name="Open production shaping"
                            Command="{Binding ShowShapingCommand}"
                            Content="Production shaping"
                            FocusVisualMargin="2"
                            UseSystemFocusVisuals="True" />
                        <Button
                            x:Name="LiveStageButton"
                            AutomationProperties.Name="Open live stage"
                            Command="{Binding ShowLiveStageCommand}"
                            Content="Live Stage"
                            FocusVisualMargin="2"
                            UseSystemFocusVisuals="True" />
                        <Button
                            x:Name="HistoryButton"
                            AutomationProperties.Name="Open history"
                            Command="{Binding ShowHistoryCommand}"
                            Content="History"
                            FocusVisualMargin="2"
                            UseSystemFocusVisuals="True" />
                        <Button
                            x:Name="BackButton"
                            AutomationProperties.Name="Back"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="OnBackClicked"
                            FocusVisualMargin="2"
                            Padding="6"
                            ToolTipService.ToolTip="Back"
                            UseSystemFocusVisuals="True"
                            Visibility="{Binding IsBackAvailable, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="20"
                                Glyph="&#xE72B;" />
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <Border
                            Padding="20,4,0,4"
                            BorderBrush="{ThemeResource KymaeanAccentBrush}"
                            BorderThickness="3,0,0,0"
                            Visibility="{Binding IsShaping, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="Production shaping" />
                                <TextBlock
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="Current possibility and cast remain inside this Production." />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="CAST" />
                                <ItemsControl ItemsSource="{Binding Cast}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="application:WorkspaceCharacter">
                                            <TextBlock
                                                Margin="0,5,0,5"
                                                FontSize="18"
                                                Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                                Text="{x:Bind DisplayName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="28"
                            Background="{ThemeResource KymaeanStageFieldBrush}"
                            BorderBrush="{ThemeResource KymaeanStageAccentBrush}"
                            BorderThickness="3,0,0,0"
                            Visibility="{Binding IsLiveStage, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanStagePrimaryBrush}"
                                        Text="Live Stage" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanStageSecondaryBrush}"
                                        Text="What is happening now" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,22,0,0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource KymaeanStageSecondaryBrush}"
                                        Text="Current Opportunity" />
                                    <TextBlock
                                        Foreground="{ThemeResource KymaeanStagePrimaryBrush}"
                                        Text="{Binding OpportunityDisplayName}" />
                                </StackPanel>

                                <ItemsControl
                                    Grid.Row="2"
                                    Margin="0,22,0,0"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding SituationLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,0,0,12"
                                                MaxWidth="760"
                                                HorizontalAlignment="Left"
                                                TextWrapping="Wrap"
                                                FontSize="17"
                                                Foreground="{ThemeResource KymaeanStagePrimaryBrush}"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border
                            Padding="20,4,0,4"
                            BorderBrush="{ThemeResource KymaeanAccentBrush}"
                            BorderThickness="3,0,0,0"
                            Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="History" />
                                <TextBlock
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="What happened and what remains in motion" />
                                <ItemsControl
                                    Margin="0,10,0,0"
                                    ItemsSource="{Binding RecentHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{ThemeResource KymaeanBoundaryBrush}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="14,0,0,0"
                                                    MaxWidth="760"
                                                    TextWrapping="Wrap"
                                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                                    Text="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="{Binding HistoricalEventCount, Converter={StaticResource HistoryCountToText}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsProductions, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                            Text="Productions" />
                        <TextBlock
                            Foreground="{ThemeResource KymaeanSecondaryBrush}"
                            Text="Switch Production scope without changing the current Production's truth." />
                        <Border
                            Margin="0,14,0,0"
                            Padding="0,12"
                            BorderBrush="{ThemeResource KymaeanBoundaryBrush}"
                            BorderThickness="0,1,0,1">
                            <StackPanel>
                                <TextBlock
                                    FontSize="18"
                                    Foreground="{ThemeResource KymaeanPrimaryBrush}"
                                    Text="{Binding ProductionName}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Foreground="{ThemeResource KymaeanSecondaryBrush}"
                                    Text="Current Production" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource KymaeanPrimaryBrush}"
                            Text="Settings" />
                    </StackPanel>
                </Grid>
                </Grid>
            </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
