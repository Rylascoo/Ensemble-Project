<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Kymaean.Windows' and '$(KymaeanDirectorPreview)' == 'true'">
    <BaseIntermediateOutputPath>obj\DirectorPreview\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\DirectorPreview\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
